      "public",
      "staff-only",
      "restricted",
      "dock"
    ],
    "roles": [
      "staff",
      "after-hours"
    ]
  },
  "answers": {
    "robots_near_people": "slow",
    "robot_speed": "walking",
    "robots_staff_zones": "when_staff_present",
    "robots_restricted_zones": "with_approval",
    "robots_after_hours": "listed_roles",
    "robot_scan_near_people": "pause",
    "glasses_capture": "staff_only",
    "robot_commands": "staff_only",
    "emergency": "stop_then_dock",
    "unknown_actions": "block"
  },
  "otherwise": "deny",
  "rules": [
    {
      "setBy": "law-and-safety",
      "id": "robots_near_people",
      "text": "Robots slow to 0.3 m/s while people are in their area.",
      "who": "kind:robot",
      "does": "tag:movement",
      "where": "*",
      "when": [
        {
          "fact": "peopleInZone",
          "op": ">",
          "value": 0
        }
      ],
      "then": {
        "answer": "limit",
        "limits": {
          "maxSpeedMps": 0.3
        }
      },
      "reason": "People are in the area; robots slow down.",
      "source": {
        "kind": "question",
        "ref": "robots_near_people:slow"
      }
    },
    {
      "setBy": "law-and-safety",
      "id": "robot_speed",
      "text": "Robots move at most 1 m/s.",
      "who": "kind:robot",
      "does": "tag:movement",
      "where": "*",
      "then": {
        "answer": "limit",
        "limits": {
          "maxSpeedMps": 1
        }
      },
      "reason": "Robots move at most 1 m/s.",
      "source": {
        "kind": "question",
        "ref": "robot_speed:walking"
      }
    },
    {
      "setBy": "company",
      "id": "robots_staff_zones",
      "text": "Robots act in staff-only areas only while staff are in them.",
      "who": "kind:robot",
      "does": "*",
      "where": "tag:staff-only",
      "when": [
        {
          "fact": "staffInZone",
          "op": "==",
          "value": 0
        }
      ],
      "then": {
        "answer": "wait",
        "for": "condition"
      },
      "reason": "This area is staff-only; wait until staff are there.",
      "source": {
        "kind": "question",
        "ref": "robots_staff_zones:when_staff_present"
      }
    },
    {
      "setBy": "company",
      "id": "robots_restricted_zones",
      "text": "Robots act in restricted areas only with a person's approval each time.",
      "who": "kind:robot",
      "does": "*",
      "where": "tag:restricted",
      "then": {
        "answer": "wait",
        "for": "approval"
      },
      "reason": "This area is restricted.",
      "source": {
        "kind": "question",
        "ref": "robots_restricted_zones:with_approval"
      }
    },
    {
      "setBy": "company",
      "id": "robots_after_hours",
      "text": "Outside opening hours, only robot roles tagged \"after-hours\" may work.",
      "who": [
        "kind:robot",
        "!tag:after-hours"
      ],
      "does": "*",
      "where": "*",
      "when": [
        {
          "fact": "localTime",
          "op": "between",
          "from": "22:00",
          "to": "07:00"
        }
      ],
      "then": {
        "answer": "deny"
      },
      "reason": "Example Grocery is closed and this robot is not tagged for after-hours work.",
      "source": {
        "kind": "question",
        "ref": "robots_after_hours:listed_roles"
      }
    },
    {
      "setBy": "company",
      "id": "robot_scan_near_people",
      "text": "Robot scans wait until the area is clear of people.",
      "who": "kind:robot",
      "does": "scan",
      "where": "*",
      "when": [
        {
          "fact": "peopleInZone",
          "op": ">",
          "value": 0
        }
      ],
      "then": {
        "answer": "wait",
        "for": "condition"
      },
      "reason": "People are in the area; wait until it is clear to scan.",
      "source": {
        "kind": "question",
        "ref": "robot_scan_near_people:pause"
      }
    },
    {
      "setBy": "company",
      "id": "glasses_capture",
      "text": "Only staff glasses may capture photos, video or audio here.",
      "who": [
        "kind:person",
        "!tag:staff"
      ],
      "does": "tag:capture",
      "where": "*",
      "then": {
        "answer": "deny"
      },
      "reason": "Glasses may not capture photos, video or audio here (staff only).",
      "source": {
        "kind": "question",
        "ref": "glasses_capture:staff_only"
      }
    },
    {
      "setBy": "company",
      "id": "robot_commands",
      "text": "Only staff may command robots from glasses.",
      "who": [
        "kind:person",
        "!tag:staff"
      ],
      "does": "command_robot",
      "where": "*",
      "then": {
        "answer": "deny"
      },
      "reason": "Only staff may command robots.",
      "source": {
        "kind": "question",
        "ref": "robot_commands:staff_only"
      }
    },
    {
      "setBy": "law-and-safety",
      "id": "emergency_stop",
      "never": true,
      "text": "In an emergency, all robots stop; the only thing they may do is return to dock.",
      "who": "kind:robot",
      "does": [
        "*",
        "!dock"
      ],
      "where": "*",
      "when": [
        {
          "fact": "emergency",
          "op": "==",
          "value": true
        }
      ],
      "then": {
        "answer": "deny",
        "instead": "dock"
      },
      "reason": "Emergency: robots stop.",
      "source": {
        "kind": "question",
        "ref": "emergency:stop_then_dock"
      }
    },
    {
      "setBy": "law-and-safety",
      "id": "emergency_stop_commands",
      "never": true,
      "text": "In an emergency, nobody commands robots from glasses.",
      "who": "kind:person",
      "does": "command_robot",
      "where": "*",
      "when": [
        {
          "fact": "emergency",
          "op": "==",
          "value": true
        }
      ],
      "then": {
        "answer": "deny"
      },
      "reason": "Emergency: nobody commands robots from glasses.",
      "source": {
        "kind": "question",
        "ref": "emergency:stop_then_dock"
      }
    },
    {
      "id": "area_role_limits:restroom",
      "never": true,
      "setBy": "site-manager",
      "text": "Restroom is limited to: cleaning_robot, staff, shopper.",
      "who": [
        "inventory_robot",
        "restock_robot"
      ],
      "does": "*",
      "where": "restroom",
      "then": {
        "answer": "deny"
      },
      "reason": "Restroom is limited to: cleaning_robot, staff, shopper.",
      "source": {
        "kind": "declaration",
        "ref": "area:restroom.allowRoles"
      }
    },
    {
      "id": "checkout_speed",
      "text": "robots slow to 0.3 m/s in checkout",
      "who": [
        "kind:robot"
      ],
      "does": "tag:movement",
      "where": [
        "checkout"
      ],
      "then": {
        "answer": "limit",
        "limits": {
          "maxSpeedMps": 0.3
        }
      },
      "source": {
        "kind": "text",
        "ref": "robots slow to 0.3 m/s in checkout"
      },
      "setBy": "site-manager"
    },
    {
      "id": "no_restock_saturday_pm",
      "text": "no restock robots in aisle 3 on Saturdays between 14:00 and 16:00",
      "who": [
        "restock_robot"
      ],
      "does": "*",
      "where": [
        "aisle-3"
      ],
      "when": [
        {
          "fact": "localTime",
          "op": "between",
          "from": "14:00",
          "to": "16:00"
        },
        {
          "fact": "day",
          "op": "days",
          "days": [
            "sat"
          ]
        }
      ],
      "then": {
        "answer": "deny"
      },
      "source": {
        "kind": "text",
        "ref": "no restock robots in aisle 3 on Saturdays between 14:00 and 16:00"
      },
      "setBy": "site-manager"
    },
    {
      "id": "shopper_photos_entrance",
      "text": "shoppers may take photos in the entrance",
      "who": [
        "shopper"
      ],
      "does": [
        "camera_capture"
      ],
      "where": [
        "entrance"
      ],
      "then": {
        "answer": "allow"
      },
      "source": {
        "kind": "text",
        "ref": "shoppers may take photos in the entrance"
      },
      "setBy": "site-manager"
    },
    {
      "id": "no_audio_back_room_lunch",
      "text": "people may not record audio in the back room between 12:00 and 13:00",
      "who": [
        "kind:person"
      ],
      "does": [
        "record_audio"
      ],
      "where": [
        "back-room"
      ],
      "when": [
        {
          "fact": "localTime",
          "op": "between",
          "from": "12:00",
          "to": "13:00"
        }
      ],
      "then": {
        "answer": "deny"
      },
      "source": {
        "kind": "text",
        "ref": "people may not record audio in the back room between 12:00 and 13:00"
      },
      "setBy": "site-manager"
    },
    {
      "id": "staff_audio_back_room",
      "text": "Staff may record audio in the back room.",
      "who": "staff",
      "does": "record_audio",
      "where": "back-room",
      "then": {
        "answer": "allow"
      },
      "setBy": "site-manager",
      "source": {
        "kind": "manual",
        "ref": "staff_audio_back_room"
      }
    },
    {
      "id": "no_carrying_through_checkout",
      "text": "Robots carrying stock do not enter the checkout.",
      "who": "kind:robot",
      "does": "enter_zone",
      "where": "checkout",
      "when": [
        {
          "fact": "carrying",
          "op": "==",
          "value": true
        }
      ],
      "then": {
        "answer": "deny",
        "instead": "place"
      },
      "reason": "Robots carrying stock do not enter the checkout; put it down first.",
      "setBy": "site-manager",
      "source": {
        "kind": "manual",
        "ref": "no_carrying_through_checkout"
      }
    }
  ],
  "builtin": [
    {
      "id": "required_facts",
      "text": "Every fact a decision needs must be supplied and valid; a missing or invalid fact is never permission."
    },
    {
      "id": "area_declared",
      "text": "Only declared areas are governed; anything in an undeclared area is blocked."
    },
    {
      "id": "role_declared",
      "text": "Only declared roles may act; unknown roles are blocked."
    },
    {
      "id": "role_permits_action",
      "text": "A participant may only take actions its role lists."
    },
    {
      "id": "unknown_action",
      "text": "An action the rulebook does not know is denied, or waits for approval, as the rulebook says (otherwise)."
    },
    {
      "id": "plan_area_continuity",
      "text": "A plan step happens where the earlier steps left the participant unless its action moves it there."
    }
  ],
  "planRules": [
    {
      "id": "scan_before_restock",
      "text": "A robot scans a shelf before it restocks it.",
      "who": "kind:robot",
      "check": {
        "kind": "before",
        "first": "scan",
        "then": "manipulate",
        "sameArea": true
      },
      "reason": "Scan the shelf before restocking it, so the plan works from what is actually there.",
      "setBy": "site-manager",
      "source": {
        "kind": "manual",
        "ref": "scan_before_restock"
      }
    },
    {
      "id": "end_at_dock",
      "text": "Every robot plan ends at a charging dock.",
      "who": "kind:robot",
      "check": {
        "kind": "ends_in",
        "areas": "tag:dock"
      },
      "reason": "Every plan ends at a charging dock.",
      "setBy": "site-manager",
      "source": {
        "kind": "manual",
        "ref": "end_at_dock"
      }
    }
  ],
  "findings": [
    {
      "kind": "tightening",
      "severity": "info",
      "ruleIds": [
        "robot_speed",
        "checkout_speed"
      ],
      "certainty": "certain",
      "witness": {
        "participant": {
          "id": "inventory_robot-1",
          "kind": "robot",
          "roleId": "inventory_robot"
        },
        "action": "enter_zone",
        "areaId": "checkout",
        "facts": {
          "peopleInZone": 0,
          "localTime": "00:00",
          "day": "mon"
        }
      },
      "message": "`checkout_speed` set by Site manager tightens `robot_speed` set by Law and safety: `robot_speed` (set by Law and safety) says limit maxSpeedMps 1; `checkout_speed` (set by Site manager) says limit maxSpeedMps 0.3. Both apply to Inventory robot, Restock robot, Cleaning robot · enter an area, move, dock · Checkout, always. A lower authority may tighten, so this is fine; `robot_speed` never takes effect there. For example: inventory_robot does enter_zone in checkout with peopleInZone=0, localTime=\"00:00\", day=\"mon\"."
    },
    {
      "kind": "authority-override",
      "severity": "conflict",
      "ruleIds": [
        "shopper_photos_entrance",
        "glasses_capture"
      ],
      "certainty": "certain",
      "witness": {
        "participant": {
          "id": "shopper-1",
          "kind": "person",
          "roleId": "shopper"
        },
        "action": "camera_capture",
        "areaId": "entrance",
        "facts": {
          "peopleInZone": 0,
          "localTime": "00:00",
          "day": "mon"
