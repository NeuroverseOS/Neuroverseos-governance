  "facts": [
    {
      "id": "peopleInZone",
      "type": "number",
      "integer": true,
      "min": 0,
      "required": true,
      "description": "People (not robots) in the area, as the spatial system reports.",
      "synonyms": [
        "people",
        "people present",
        "people in the area",
        "people in the zone",
        "shoppers present"
      ]
    },
    {
      "id": "staffInZone",
      "type": "number",
      "integer": true,
      "min": 0,
      "default": 0,
      "description": "Staff in the area. Absent means 0.",
      "synonyms": [
        "staff present",
        "staff in the area",
        "staff in the zone"
      ]
    },
    {
      "id": "localTime",
      "type": "time",
      "required": true,
      "description": "Local time \"HH:MM\". The rulebook has no clock.",
      "synonyms": [
        "time"
      ]
    },
    {
      "id": "requestedSpeedMps",
      "type": "number",
      "min": 0,
      "description": "Requested speed in m/s for movement. Absent means \"cap me\"."
    },
    {
      "id": "emergency",
      "type": "boolean",
      "default": false,
      "description": "True while a site emergency is active. The one fact with a default, because an emergency is an explicit event your system raises.",
      "synonyms": [
        "emergency",
        "alarm",
        "fire alarm"
      ]
    },
    {
      "id": "targetRobotId",
      "type": "string",
      "description": "For command_robot: the robot being commanded."
    },
    {
      "id": "carrying",
      "type": "boolean",
      "default": false,
      "description": "True while a robot is carrying stock. In a plan, manipulate sets it and place clears it.",
      "synonyms": [
        "carrying",
        "loaded",
        "carrying stock"
      ]
    },
    {
      "id": "day",
      "type": "day",
      "required": true,
      "description": "Day of the week."
    }
  ],
  "limits": [
    {
      "id": "maxSpeedMps",
      "name": "top speed",
      "unit": "m/s",
      "requestedFact": "requestedSpeedMps",
