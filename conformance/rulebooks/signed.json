  "rules": [
    {
      "id": "area_role_limits:office",
      "never": true,
      "setBy": "low",
      "text": "Office is limited to: guard, lead.",
      "who": [
        "bot",
        "visitor",
        "planner"
      ],
      "does": "*",
      "where": "office",
      "then": {
        "answer": "deny"
      },
      "reason": "Office is limited to: guard, lead.",
      "source": {
        "kind": "declaration",
        "ref": "area:office.allowRoles"
      }
    },
    {
      "id": "area_role_limits:lab:deny",
      "never": true,
      "setBy": "low",
      "text": "Planner may never act in Lab.",
      "who": [
        "planner"
      ],
      "does": "*",
      "where": "lab",
      "then": {
        "answer": "deny"
      },
      "reason": "Planner may never act in Lab.",
      "source": {
        "kind": "declaration",
        "ref": "area:lab.denyRoles"
      }
    },
    {
      "setBy": "high",
      "id": "ask_high",
      "text": "ask_high",
      "who": "*",
      "does": "go",
      "where": "yard",
      "then": {
        "answer": "wait",
        "for": "approval",
        "by": "high"
      },
      "source": {
        "kind": "manual",
        "ref": "ask_high"
      }
    },
    {
      "setBy": "high",
      "id": "ask_twice",
      "text": "ask_twice",
      "who": "*",
      "does": "go",
      "where": "yard",
      "then": {
        "answer": "wait",
        "for": "approval",
        "by": "high"
      },
      "when": [
        {
          "fact": "mode",
          "op": "==",
          "value": "b"
        }
      ],
      "source": {
        "kind": "manual",
        "ref": "ask_twice"
      }
    },
    {
      "setBy": "high",
      "id": "ask_lead",
      "text": "ask_lead",
      "who": "bot",
      "does": "look",
      "where": "*",
      "then": {
        "answer": "wait",
        "for": "approval",
        "by": "tag:lead"
      },
      "source": {
        "kind": "manual",
        "ref": "ask_lead"
      }
    },
    {
      "setBy": "high",
      "id": "crowd_wait",
      "text": "crowd_wait",
      "who": "*",
      "does": "go",
      "where": "yard",
      "then": {
        "answer": "wait",
        "for": "condition"
      },
      "when": [
        {
          "fact": "people",
          "op": ">=",
          "value": 3
        }
      ],
      "source": {
        "kind": "manual",
        "ref": "crowd_wait"
      }
    },
    {
      "setBy": "high",
      "id": "alarm_stop",
      "text": "alarm_stop",
      "who": "*",
      "does": "*",
      "where": "*",
      "then": {
        "answer": "deny"
      },
      "never": true,
      "when": [
        {
          "fact": "alarm",
          "op": "==",
          "value": true
        }
      ],
      "source": {
        "kind": "manual",
        "ref": "alarm_stop"
      }
    },
    {
      "setBy": "high",
      "id": "no_yard_at_night",
      "text": "no_yard_at_night",
      "who": "*",
      "does": "go",
      "where": "yard",
      "then": {
