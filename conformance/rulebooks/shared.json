  "rules": [
    {
      "id": "area_role_limits:office",
      "never": true,
      "setBy": "low",
      "text": "Office is limited to: guard, lead.",
      "who": [
        "bot",
        "visitor",
        "planner"
      ],
      "does": "*",
      "where": "office",
      "then": {
        "answer": "deny"
      },
      "reason": "Office is limited to: guard, lead.",
      "source": {
        "kind": "declaration",
        "ref": "area:office.allowRoles"
      }
    },
    {
      "id": "area_role_limits:lab:deny",
      "never": true,
      "setBy": "low",
      "text": "Planner may never act in Lab.",
      "who": [
        "planner"
      ],
      "does": "*",
      "where": "lab",
      "then": {
        "answer": "deny"
      },
      "reason": "Planner may never act in Lab.",
      "source": {
        "kind": "declaration",
        "ref": "area:lab.denyRoles"
      }
    },
    {
      "setBy": "high",
      "id": "no_looking_outside",
      "text": "no_looking_outside",
      "who": "*",
      "does": "look",
      "where": "yard",
      "then": {
        "answer": "deny"
      },
      "source": {
        "kind": "manual",
        "ref": "no_looking_outside"
      }
    },
    {
      "setBy": "high",
      "id": "agents_plan_with_approval",
      "text": "agents_plan_with_approval",
      "who": "kind:agent",
      "does": "plan",
      "where": "*",
      "then": {
        "answer": "wait",
        "for": "approval",
        "by": "tag:staff"
      },
      "source": {
        "kind": "manual",
        "ref": "agents_plan_with_approval"
      }
    },
    {
      "setBy": "high",
      "id": "non_staff_out_of_lab",
      "text": "non_staff_out_of_lab",
      "who": [
        "kind:person",
        "!tag:staff"
      ],
      "does": "*",
      "where": "lab",
      "then": {
        "answer": "deny"
      },
      "source": {
        "kind": "manual",
        "ref": "non_staff_out_of_lab"
      }
    }
