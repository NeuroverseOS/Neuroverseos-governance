  "otherwise": "deny",
  "rules": [
    {
      "id": "scope_role_limits:mail:deny",
      "never": true,
      "setBy": "plan",
      "text": "Reader may never act in Mail.",
      "who": [
        "reader"
      ],
      "does": "*",
      "where": "mail",
      "then": {
        "answer": "deny"
      },
      "reason": "Reader may never act in Mail.",
      "source": {
        "kind": "declaration",
        "ref": "scope:mail.denyRoles"
      }
    },
    {
      "setBy": "owner",
      "id": "cap",
      "text": "cap",
      "who": "*",
      "does": "pay",
      "where": "*",
      "then": {
        "answer": "deny"
      },
      "when": [
        {
          "fact": "projected_spend",
          "op": ">",
          "value": 500
        }
      ],
      "source": {
        "kind": "manual",
        "ref": "cap"
      }
    },
    {
      "setBy": "owner",
      "id": "pay_waits",
      "text": "pay_waits",
      "who": "worker",
      "does": "pay",
      "where": "*",
      "then": {
        "answer": "wait",
        "for": "approval",
        "by": "owner"
      },
      "source": {
        "kind": "manual",
        "ref": "pay_waits"
      }
    },
    {
      "setBy": "law",
      "id": "no_external",
      "text": "no_external",
      "who": "*",
      "does": "send",
      "where": "*",
      "then": {
        "answer": "deny"
      },
      "when": [
        {
          "fact": "external",
          "op": "==",
          "value": true
        }
      ],
      "never": true,
      "source": {
        "kind": "manual",
        "ref": "no_external"
      }
    },
    {
      "setBy": "owner",
      "id": "small_writes",
      "text": "small_writes",
      "who": "*",
      "does": "write",
      "where": "*",
      "then": {
        "answer": "limit",
        "limits": {
          "max_bytes": 1000
        }
      },
      "source": {
        "kind": "manual",
        "ref": "small_writes"
      }
    },
    {
      "id": "mission_tools",
      "text": "During mission \"m1\" only read, write, pay may be used.",
      "who": "*",
      "does": [
        "!read",
        "!write",
        "!pay"
      ],
      "where": "*",
      "then": {
        "answer": "deny"
      },
