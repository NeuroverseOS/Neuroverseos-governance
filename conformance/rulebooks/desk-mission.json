      "source": {
        "kind": "system",
        "ref": "plan:m1/permits"
      }
    },
    {
      "id": "write_in_files_only",
      "text": "During mission \"m1\", write may be used only in files.",
      "who": "*",
      "does": "write",
      "where": [
        "!files"
      ],
      "then": {
        "answer": "deny"
      },
      "setBy": "plan",
      "source": {
        "kind": "system",
        "ref": "plan:m1/permits:write"
      }
    },
    {
      "id": "mission_pay_approval",
      "text": "During mission \"m1\", pay waits for owner's approval.",
      "who": "*",
      "does": "pay",
      "where": "*",
      "then": {
        "answer": "wait",
        "for": "approval",
        "by": "owner"
      },
      "setBy": "plan",
      "source": {
        "kind": "system",
        "ref": "plan:m1/approvals:pay"
      }
    },
    {
      "id": "read_first",
      "text": "During mission \"m1\", read must have happened before write.",
      "who": "*",
      "does": "write",
      "where": "*",
