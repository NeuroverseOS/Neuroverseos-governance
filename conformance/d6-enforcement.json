[
  {
    "id": "d6-block-never-executes",
    "principle": [
      3,
      4,
      9
    ],
    "description": "ENFORCEMENT: a call the rules refuse (external mail with the never rule) never reaches the executor.",
    "rulebookRef": "rulebooks/desk.json",
    "call": {
      "id": "c1",
      "function": {
        "name": "send",
        "arguments": "{\"to\":\"acme.example\"}"
      }
    },
    "session": {
      "principal": {
        "id": "sam"
      },
      "participant": {
        "id": "w-1",
        "kind": "agent",
        "roleId": "worker"
      }
    },
    "harness": {
      "scope": "mail",
      "facts": {
        "external": true
      }
    },
    "forbidKeys": [
      "signature",
      "privateKey"
    ],
    "expect": {
      "enforcement": {
        "status": "BLOCK",
        "executed": false,
        "reasons": [
          "no_external"
        ]
      }
    }
  },
  {
    "id": "d6-pause-never-executes",
    "principle": [
      3,
      4,
      9
    ],
    "description": "A call that waits for approval (a worker's payment) never reaches the executor either.",
    "rulebookRef": "rulebooks/desk.json",
    "call": {
      "function": {
        "name": "pay",
        "arguments": "{\"amount\": 50}"
      }
    },
    "session": {
      "principal": {
        "id": "sam"
      },
      "participant": {
        "id": "w-1",
        "kind": "agent",
        "roleId": "worker"
      }
    },
    "harness": {
      "scope": "bank",
      "ledger": {
        "fact": "projected_spend",
        "amountArg": "amount",
        "spent": 0
      }
    },
    "forbidKeys": [
      "signature",
      "privateKey"
    ],
    "expect": {
      "enforcement": {
        "status": "PAUSE",
        "executed": false,
        "reasons": [
          "pay_waits"
        ]
      }
    }
  },
  {
    "id": "d6-allow-executes-once",
    "principle": [
      3,
      4,
      9
    ],
    "description": "An allowed call runs the executor exactly once (the OpenAI shape with stringified arguments).",
    "rulebookRef": "rulebooks/desk.json",
    "call": {
      "id": "c3",
      "function": {
        "name": "read",
        "arguments": "{}"
      }
    },
    "session": {
      "principal": {
        "id": "sam"
      },
      "participant": {
        "id": "w-1",
        "kind": "agent",
        "roleId": "worker"
      }
    },
    "harness": {
      "scope": "files"
    },
    "forbidKeys": [
      "signature",
      "privateKey"
    ],
    "expect": {
      "enforcement": {
        "status": "ALLOW",
        "executed": true,
        "reasons": [
          "role_permits_tool"
        ]
      }
    }
  },
  {
    "id": "d6-limit-executes-with-limits",
    "principle": [
      3,
      4,
      9
    ],
    "description": "A LIMIT call runs the executor once and hands it the effective limits.",
    "rulebookRef": "rulebooks/desk.json",
    "call": {
