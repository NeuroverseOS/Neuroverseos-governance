[
  {
    "id": "d6-block-never-executes",
    "principle": [
      3,
      4,
      9
    ],
    "description": "ENFORCEMENT: a call the rules refuse (external mail with the never rule) never reaches the executor.",
    "rulebookRef": "rulebooks/desk.json",
    "call": {
      "id": "c1",
      "function": {
        "name": "send",
        "arguments": "{\"to\":\"acme.example\"}"
      }
    },
    "session": {
      "principal": {
        "id": "sam"
      },
      "participant": {
        "id": "w-1",
        "kind": "agent",
        "roleId": "worker"
      }
    },
    "harness": {
      "scope": "mail",
      "facts": {
        "external": true
      }
    },
    "forbidKeys": [
      "signature",
      "privateKey"
    ],
    "expect": {
      "enforcement": {
        "status": "BLOCK",
        "executed": false,
        "outcome": "not_run",
        "reasons": [
          "no_external"
        ]
      }
    }
  },
  {
