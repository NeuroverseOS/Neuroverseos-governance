{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "examples/**/*.ts",
    "test/**/*.ts",
    "conformance/**/*.ts",
    "adapters/tool-call/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "examples/mcp",
    "src/spatial",
    "src/adapters"
  ]
}
