{
  "name": "@neuroverseos/governance",
  "version": "1.0.0-rc.1",
  "description": "Rules for AI agents, robots and people under one law: a declared-authority rulebook, one deterministic evaluator (ALLOW | LIMIT | PAUSE | BLOCK with reasons and the authority behind them), tool arguments bound to facts, bounded delegation, approvals bound to the exact call, missions that only tighten, an enforcing tool-call adapter, a backtest of recorded logs, and a language-neutral spec (neuroverse-governance/1; robot-domain-rules/3 as the robotics dialect) with conformance tests.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "spec",
    "conformance/*.json",
    "conformance/rulebooks",
    "conformance/compare.mjs",
    "conformance/compare.d.mts",
    "conformance/run-node.mjs",
    "conformance/validate-schemas.mjs",
    "conformance/README.md",
    "adapters/tool-call",
    "acceptance/invoice-reconciliation",
    "examples/*.ts",
    "examples/harness",
    "examples/backtest",
    "examples/mcp/server.ts",
    "examples/mcp/package.json",
    "examples/mcp/tsconfig.json",
    "examples/mcp/README.md",
    "README.md",
    "PRINCIPLES.md",
    "SPEC.md",
    "BOUNDARY.md",
    "RELATED-WORK.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run --dir test",
    "typecheck": "tsc --noEmit",
    "conformance": "node conformance/run-node.mjs",
    "conformance:schemas": "node conformance/validate-schemas.mjs",
    "conformance:generate": "tsx conformance/generate.ts",
    "acceptance": "tsx acceptance/invoice-reconciliation/run.ts",
    "acceptance:backtest": "tsx acceptance/invoice-reconciliation/backtest.ts",
    "acceptance:generate": "tsx acceptance/invoice-reconciliation/generate.ts",
    "eval:live": "tsx eval/live/run.ts",
    "demo": "tsx examples/demo.ts",
    "replay": "tsx examples/harness/replay.ts",
    "plan-replay": "tsx examples/harness/plan-replay.ts",
    "backtest": "tsx examples/backtest/backtest.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run conformance && npm run conformance:schemas && npm run acceptance && npm run acceptance:backtest"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "ajv": "^8.20.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0",
    "z3-solver": "^5.2.0"
  },
  "keywords": [
    "governance",
    "ai-agents",
    "tool-calls",
    "authorization",
    "rules",
    "approvals",
    "delegation",
    "robotics",
    "smart-glasses",
    "conformance",
    "backtesting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeuroverseOS/neuroverseos-governance.git"
  },
  "homepage": "https://github.com/NeuroverseOS/neuroverseos-governance",
  "bugs": {
    "url": "https://github.com/NeuroverseOS/neuroverseos-governance/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
